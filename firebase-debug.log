[debug] [2026-05-09T18:02:39.330Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ikamba-1c669/rulesets {"name":"projects/ikamba-1c669/rulesets/d442b341-de22-4951-bea8-4cc790c625fb","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Helpers ────────────────────────────────────────────────────────────\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    function txnOwnerMatches(data) {\n      return isSignedIn() && (\n        data.userId == request.auth.uid ||\n        data.user_id == request.auth.uid ||\n        data.user == request.auth.uid\n      );\n    }\n\n    // Staff = admin or agent — full access to the entire database.\n    function isStaff() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && (\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent' ||\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true\n        );\n    }\n\n    // ══════════════════════════════════════════════════════════════════════\n    // STAFF FULL ACCESS\n    // ══════════════════════════════════════════════════════════════════════\n    match /{document=**} {\n      allow read, write: if isStaff();\n    }\n\n    // ══════════════════════════════════════════════════════════════════════\n    // REGULAR USER RULES\n    // ══════════════════════════════════════════════════════════════════════\n\n    match /rates/{rateId} {\n      allow read: if true;\n    }\n\n    match /clientLogs/{logId} {\n      allow read: if false;\n      allow create: if isSignedIn();\n      allow update, delete: if false;\n    }\n\n    match /auditEvents/{eventId} {\n      allow read: if false;\n      allow write: if false;\n    }\n\n    match /alertThrottle/{key} {\n      allow read, write: if false;\n    }\n\n    match /users/{userId} {\n      allow read:   if isOwner(userId);\n      allow create: if isOwner(userId);\n      allow update: if isOwner(userId);\n      allow delete: if false;\n\n      match /transactions/{txId} {\n        allow read:   if isOwner(userId);\n        allow create: if isOwner(userId);\n        allow update: if isOwner(userId);\n        allow delete: if false;\n      }\n\n      match /automations/{automationId} {\n        allow read:   if isOwner(userId);\n        allow create: if isOwner(userId);\n        allow update: if isOwner(userId);\n        allow delete: if isOwner(userId);\n\n        match /logs/{logId} {\n          allow read: if isOwner(userId);\n          allow write: if false;\n        }\n      }\n\n      match /locationHistory/{entryId} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n\n    match /transactions/{txId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn()\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.diff(resource.data).affectedKeys()\n                        .hasOnly(['paymentProofUrl', 'paymentProofUrls', 'transactionstatus', 'updatedAt', 'updatedBy']);\n      allow delete: if false;\n    }\n\n    match /pending_transactions/{txId} {\n      allow read:   if txnOwnerMatches(resource.data);\n      allow create: if txnOwnerMatches(request.resource.data);\n      allow update: if txnOwnerMatches(resource.data) && txnOwnerMatches(request.resource.data);\n      allow delete: if false;\n    }\n\n    match /{path=**}/transactions/{txId} {\n      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n\n    match /{path=**}/automations/{automationId} {\n      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n\n    match /bars/{userId} {\n      allow read:           if isOwner(userId);\n      allow create, update: if isOwner(userId);\n      allow delete:         if false;\n    }\n\n    match /barsHistory/{entryId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if false;\n    }\n\n    match /deposits/{depositId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if false;\n    }\n\n    match /depositSessions/{sessionId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if false;\n    }\n\n    match /barsSettings/{docId} {\n      allow read:  if isSignedIn();\n      allow write: if false;\n    }\n\n    match /feedback/{feedbackId} {\n      allow create: if isSignedIn();\n      allow read, update, delete: if false;\n    }\n\n    match /wallets/{walletId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn()\n        && resource.data.userId == request.auth.uid\n        && request.resource.data.userId == resource.data.userId\n        && request.resource.data.currency == resource.data.currency\n        && request.resource.data.walletAddress == resource.data.walletAddress\n        && request.resource.data.balance >= 0\n        && request.resource.data.reservedBalance >= 0;\n      allow delete: if false;\n    }\n\n    match /walletHistory/{entryId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if false;\n      allow update, delete: if false;\n    }\n\n    match /walletSettings/{userId} {\n      allow read, write: if isSignedIn() && request.auth.uid == userId;\n    }\n\n    match /recipients/{recipientId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n\n    match /kyc_documents/{docId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /kycDocuments/{docId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /paymentProofs/{proofId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /rateAdjustments/{docId} { allow read: if true; }\n    match /currencies/{currencyId} { allow read: if true; }\n    match /feeConfigs/{feeId}       { allow read: if true; }\n    match /deliveryOptions/{docId}  { allow read: if true; }\n    match /currencyPairs/{docId}    { allow read: if true; }\n    match /paymentMethods/{methodId}{ allow read: if true; }\n\n    match /notification_recipients/{recipientId} {\n      allow read: if isSignedIn();\n    }\n\n    match /appdata/{docId} {\n      allow read:  if true;\n      allow write: if isStaff();\n      match /{sub=**} {\n        allow read: if true;\n      }\n    }\n\n    match /userActivities/{activityId} {\n      allow create: if isSignedIn();\n    }\n\n    match /pageAnalytics/{docId} {\n      allow read:  if isSignedIn();\n      allow write: if isSignedIn();\n    }\n\n    match /wrapped_analytics/{entryId} {\n      allow create: if isSignedIn();\n      allow read, update, delete: if false;\n    }\n\n    match /wrappers/{wrapperId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn()\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.diff(resource.data).affectedKeys()\n                        .hasOnly(['viewed', 'viewedAt']);\n      allow create, delete: if false;\n    }\n\n    match /userPresence/{userId} {\n      allow read:  if isOwner(userId);\n      allow write: if isOwner(userId);\n      match /locationHistory/{entryId} {\n        allow read, write: if isOwner(userId);\n      }\n      match /pageHistory/{entryId} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n\n    // ── mail / mailverify — Trigger Email extension ────────────────────────\n    // Hpersona writes to /mail too (Pro activation, credit-request emails).\n    match /mail/{mailId}      { allow create: if isSignedIn(); allow read, update, delete: if false; }\n    match /mailverify/{docId} { allow create: if isSignedIn(); allow read, update, delete: if false; }\n\n    match /notification_locks/{lockId} {\n      allow read, create, update: if isSignedIn();\n      allow delete: if false;\n    }\n\n    match /email_otps/{otpId} {\n      allow create: if isSignedIn();\n      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow delete: if false;\n    }\n\n    match /cardholders/{cardholderId} {\n      allow read, write: if false;\n      match /transactionHistory/{txId} { allow read, write: if false; }\n      match /resetHistory/{entryId}    { allow read, write: if false; }\n    }\n\n    match /cardholderSummary/{docId} { allow read, write: if false; }\n\n    match /currencyRates/{docId} {\n      allow read:  if true;\n      allow write: if false;\n    }\n\n    match /rate/{docId} { allow read, write: if false; }\n\n    // ══════════════════════════════════════════════════════════════════════\n    // AI MONITORING SYSTEM\n    // ══════════════════════════════════════════════════════════════════════\n\n    match /userBlocks/{blockId} {\n      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow write: if false;\n    }\n\n    match /aiAlerts/{alertId}        { allow read, write: if false; }\n    match /aiActions/{actionId}      { allow read, write: if false; }\n    match /aiAuditLog/{logId}        { allow read, write: if false; }\n    match /userRiskProfiles/{userId} { allow read, write: if false; }\n    match /systemHealthLog/{docId}   { allow read, write: if false; }\n    match /dailySummaries/{docId}    { allow read, write: if false; }\n    match /aiBudgetLog/{docId}       { allow read, write: if false; }\n    match /rateAdjustmentLog/{logId} { allow read, write: if false; }\n\n    // ══════════════════════════════════════════════════════════════════════\n    // IKAMBAVPN COLLECTIONS\n    // ══════════════════════════════════════════════════════════════════════\n\n    match /app_config/{docId} { allow read: if true; }\n\n    match /vpn_orders/{orderId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn()\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.diff(resource.data).affectedKeys()\n                        .hasOnly(['paymentProofUrl', 'status', 'updatedAt'])\n                    && (\n                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])\n                         || (resource.data.status == 'pending_payment'\n                             && request.resource.data.status == 'payment_submitted')\n                       );\n      allow delete: if false;\n    }\n\n    match /vpn_plans/{planId}                { allow read: if true; }\n    match /vpn_payment_accounts/{accountId}  { allow read: if isSignedIn(); }\n\n    match /vpn_trials/{trialId} {\n      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn()\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.userId == resource.data.userId\n                    && request.resource.data.diff(resource.data).affectedKeys()\n                        .hasOnly(['status', 'updatedAt', 'credentials', 'expiresAt']);\n      allow delete: if false;\n    }\n\n    match /vpn_clients/{clientId} { allow read, write: if false; }\n\n    // ══════════════════════════════════════════════════════════════════════\n    // HPERSONA — humanizer usage, credit requests, Pro subscription orders\n    // Staff access is already covered by the staff wildcard at the top.\n    // ══════════════════════════════════════════════════════════════════════\n\n    // ── humanizerUsage/{uid} ──────────────────────────────────────────────\n    // { uid, used, limit, unlimited, proUntil?, updatedAt }\n    //\n    // Owner can read their own ledger and bump `used` (consume words).\n    // Owner CANNOT change limit / unlimited / proUntil from the client —\n    // those are admin-only, or written by the YooKassa webhook (Admin SDK).\n    match /humanizerUsage/{uid} {\n      allow read: if isOwner(uid);\n\n      allow create: if isOwner(uid)\n        && request.resource.data.uid == uid\n        && request.resource.data.used is int\n        && request.resource.data.used >= 0\n        && request.resource.data.limit is int\n        && request.resource.data.limit <= 20000\n        && request.resource.data.unlimited == false\n        && !('proUntil' in request.resource.data);\n\n      // Owner update: only `used` may grow (consumeUsage).\n      allow update: if isOwner(uid)\n        && request.resource.data.uid == resource.data.uid\n        && request.resource.data.limit == resource.data.limit\n        && request.resource.data.unlimited == resource.data.unlimited\n        && request.resource.data.get('proUntil', null) == resource.data.get('proUntil', null)\n        && request.resource.data.used is int\n        && request.resource.data.used >= resource.data.used;\n\n      allow delete: if false;\n    }\n\n    // ── humanizerRequests/{id} ────────────────────────────────────────────\n    // { uid, email, displayName, message, requestedLimit, status,\n    //   createdAt, decidedBy?, decidedAt? }\n    //\n    // Users create their own pending requests and read their own.\n    // Only staff can decide them.\n    match /humanizerRequests/{id} {\n      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;\n\n      allow create: if isSignedIn()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.status == 'pending'\n        && request.resource.data.email is string\n        && request.resource.data.message is string\n        && request.resource.data.message.size() <= 2000;\n\n      allow update, delete: if false;\n    }\n\n    // ── humanizerOrders/{id} ──────────────────────────────────────────────\n    // YooKassa Pro subscription orders. ALL writes go through the Admin SDK\n    // (Vercel API routes), which bypasses these rules. Clients may only read\n    // their own to support the return-from-checkout polling flow.\n    match /humanizerOrders/{id} {\n      allow read:  if isSignedIn() && resource.data.uid == request.auth.uid;\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-09T18:02:39.593487Z","metadata":{"services":["cloud.firestore"]}}
